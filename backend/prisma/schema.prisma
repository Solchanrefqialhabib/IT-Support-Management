generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  IT_SUPPORT
  SUPERVISOR
}

enum VisitStatus {
  PENDING
  SELESAI
}

enum ItemStatus {
  READY
  DIPAKAI
  RUSAK
  RMA
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(IT_SUPPORT)
  visits    Visit[]
  checkouts ItemCheckout[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  allowance Int
  visits    Visit[]
  checkouts ItemCheckout[]
  returns   ItemReturn[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visit {
  id              Int      @id @default(autoincrement())
  date            DateTime
  branchId        Int
  userId          Int
  category        String
  startTime       String
  endTime         String
  solution        String?  
  beforeCondition String?  
  beforeImage     String?  
  afterImage      String?  
  status          String   @default("PENDING")
  allowance       Float

  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Item {
  id           Int          @id @default(autoincrement())
  itemCode     String       @unique
  serialNumber String?      @unique
  itemName     String
  category     String
  stock        Int
  status       ItemStatus
  checkouts    ItemCheckout[]
  returns      ItemReturn[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ItemCheckout {
  id        Int      @id @default(autoincrement())
  itemId    Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  quantity  Int      @default(1)
  status    String   @default("DIPINJAM") // DIPINJAM, DIKEMBALIKAN, MUTASI
  date      DateTime @default(now())
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemReturn {
  id           Int        @id @default(autoincrement())
  itemId       Int
  branchId     Int
  date         DateTime
  serialNumber String
  damage       String
  status       ItemStatus
  item         Item       @relation(fields: [itemId], references: [id])
  branch       Branch     @relation(fields: [branchId], references: [id])
  createdAt    DateTime   @default(now())
}